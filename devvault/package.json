{
  "name": "devvault-manager",
  "displayName": "DevVault Manager",
  "description": "Salve extensões favoritas e perfis com suas versões e compartilhe essas listas por exportação e importação de arquivos JSON.",
  "icon": "images/icon.png",
  "version": "0.0.1",
  "publisher": "ArtePrime",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": ["extensions", "extension manager", "favorites", "favoritos", "profiles", "perfis", "import", "export", "json"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devvault.exportFavorites",
        "title": "DevVault: Exportar favoritos"
      },
      {
        "command": "devvault.importFavorites",
        "title": "DevVault: Importar favoritos"
      },
      {
        "command": "devvault.listExtensions",
        "title": "DevVault: Listar extensões"
      },
      {
        "command": "devvault.manageFavorites",
        "title": "DevVault: Gerenciar favoritos"
      },
      {
        "command": "devvault.showFavorites",
        "title": "DevVault: Mostrar favoritos"
      },
      {
        "command": "devvault.createProfile",
        "title": "DevVault: Criar perfil"
      },
      {
        "command": "devvault.showProfiles",
        "title": "DevVault: Mostrar perfis"
      },
      {
        "command": "devvault.manageProfiles",
        "title": "DevVault: Gerenciar perfis"
      },
      {
        "command": "devvault.exportProfile",
        "title": "DevVault: Exportar perfil"
      },
      {
        "command": "devvault.importProfile",
        "title": "DevVault: Importar perfil"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.136.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
